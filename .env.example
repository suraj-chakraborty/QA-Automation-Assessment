# ==============================================================================
# Streamhub Fullstack + QA Automation Assessment - Environment Configuration
# Copy this file to .env before starting the server or running test suites:
#   Windows: copy .env.example .env
#   POSIX:   cp .env.example .env
# ==============================================================================

# Node Environment ('development' | 'test' | 'production')
NODE_ENV=development

# ------------------------------------------------------------------------------
# API Server Configuration (Express Backend - Milestone S03)
# ------------------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=3100
PORT=3100
API_BASE_URL=http://127.0.0.1:3100

# ------------------------------------------------------------------------------
# Target Live Application Under Test (EMI Calculator - S05, S08, S09, S10)
# ------------------------------------------------------------------------------
EMI_BASE_URL=https://emicalculator.net/

# ------------------------------------------------------------------------------
# Playwright Browser Execution & Timeouts
# ------------------------------------------------------------------------------
# Set HEADLESS=false to observe browser execution visually in headed mode
HEADLESS=true
# Delay in milliseconds between Playwright actions (0 for headless execution)
SLOW_MO=0
# Default navigation and locator wait timeout in milliseconds
DEFAULT_TIMEOUT_MS=15000

# ------------------------------------------------------------------------------
# Test Execution Concurrency
# ------------------------------------------------------------------------------
# Keep UI_PARALLEL low (2) to respect third-party server rate limits politely
UI_PARALLEL=2
# In-memory Express API can support higher concurrency
API_PARALLEL=4

# ------------------------------------------------------------------------------
# Polite Automation - Network Interception (Milestones S05, S07)
# Comma-separated list of ad/analytics domain substrings to abort during navigation
# ------------------------------------------------------------------------------
BLOCKED_HOSTS=doubleclick.net,googlesyndication.com,google-analytics.com,googletagmanager.com,adnxs.com,amazon-adsystem.com,smartadserver.com,scorecardresearch.com

# ------------------------------------------------------------------------------
# Database Storage (SQLite - Milestones S02, S07, S11)
# ------------------------------------------------------------------------------
SQLITE_PATH=data/streamhub.db
DB_PATH=data/streamhub.db

# ------------------------------------------------------------------------------
# AI Self-Healing Engine (Milestones S11, S12)
# Supported providers: mock (default, offline deterministic) | gemini | anthropic
# ------------------------------------------------------------------------------
HEAL_PROVIDER=mock
HEAL_API_KEY=
