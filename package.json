{
  "name": "streamhub-qa-automation-assessment",
  "version": "1.0.0",
  "description": "Streamhub Fullstack + QA Automation Assessment (Section B)",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "lint": "eslint . --ext .ts --max-warnings=0",
    "lint:fix": "eslint . --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "rimraf dist test-results playwright-report traces reports/temp .tsbuildinfo",
    "build": "tsc",
    "api:start": "tsx api/src/server.ts",
    "api:dev": "tsx watch api/src/server.ts",
    "data:verify": "tsx api/scripts/verify-data.ts",
    "test:smoke": "cucumber-js --profile smoke",
    "test:api": "cucumber-js --profile api",
    "test:ui": "cucumber-js --profile ui",
    "test:sql": "cucumber-js --profile sql",
    "test:self-heal": "cucumber-js --profile selfHeal",
    "test:all": "cucumber-js --profile default",
    "test": "npm run typecheck && npm run lint && npm run test:all",
    "sql:run": "tsx sql/run.ts",
    "db:seed": "tsx scripts/seed-db.ts",
    "sql:verify": "tsx scripts/verify-sql.ts",
    "heal": "tsx healing/heal.ts",
    "report": "tsx scripts/report.ts",
    "audit": "tsx scripts/audit.ts",
    "playwright:install": "playwright install chromium"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "compression": "1.7.5",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "helmet": "8.0.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@cucumber/cucumber": "10.9.0",
    "@playwright/test": "1.49.1",
    "@types/better-sqlite3": "7.6.12",
    "@types/compression": "1.7.5",
    "@types/express": "4.17.21",
    "@types/node": "20.17.10",
    "@types/supertest": "6.0.2",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "eslint": "8.57.1",
    "eslint-config-prettier": "9.1.0",
    "multiple-cucumber-html-reporter": "3.8.0",
    "prettier": "3.4.2",
    "rimraf": "6.0.1",
    "supertest": "7.0.0",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "tsx": "4.19.2",
    "typescript": "5.7.3"
  }
}
